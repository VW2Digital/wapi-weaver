# Configuração do Banco de Dados
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="wapi_user"
DB_PASSWORD="your-strong-db-password"
DB_NAME="wapi_weaver"
MYSQL_ROOT_PASSWORD="your-strong-root-password"

# Segurança da Aplicação
JWT_SECRET="super-secret-key-change-this-in-production"

# Flags de Feature
WHATSAPP_GROUPS_ENABLED="false"

# Integração Servidor de Licenças (Painel Master)
LICENSE_SERVER_URL="https://admin.seu-dominio.com"
LICENSE_APP_ID="meu-saas"
LICENSE_API_SECRET="segredo-compartilhado-entre-saas-e-painel"
LICENSE_ROLE="saas"

# Integração Redis (Opcional - Escala Webhooks)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Integração Oficial Meta/WhatsApp (Graph API / Cloud API)
VITE_META_APP_ID="seu-app-id"
VITE_META_CONFIG_ID="seu-config-id"
META_APP_SECRET="seu-app-secret"
META_VERIFY_TOKEN="WAPI_WEAVER_VERIFY_TOKEN_123"
META_API_VERSION="v20.0"

# ── Mercado Pago / Billing ──────────────────────────────────────────────────
# URL pública da aplicação (OBRIGATÓRIO em produção para webhook e URLs de retorno)
SITE_URL="https://meudominio.com.br"

# Chave AES-256 para criptografar tokens Mercado Pago no banco de dados (OBRIGATÓRIO em produção)
# Gere uma nova chave: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MERCADOPAGO_ENCRYPTION_KEY="cole-aqui-a-chave-hex-de-64-caracteres"
