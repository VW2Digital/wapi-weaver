# Configuração do Banco de Dados (MySQL)
DB_HOST="mysql"
DB_PORT="3306"
DB_USER="wapi_user"
DB_PASSWORD="generate-unique-db-password"
DB_NAME="wapi_weaver"
MYSQL_ROOT_PASSWORD="generate-unique-root-password"

# Configuração do Cache e Fila (Redis)
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_PASSWORD="generate-unique-redis-password"

# Segurança e Autenticação
JWT_SECRET="generate-unique-jwt-secret-min-32-chars"
NODE_ENV="production"
PORT=3000

# Domínio e CORS
APP_URL="https://app.seudominio.com"
CORS_ALLOWED_ORIGINS="https://app.seudominio.com"

# Criptografia de Credenciais Integradas (ex: MercadoPago, Meta)
MERCADOPAGO_ENCRYPTION_KEY="generate-unique-64-char-hex-key"
TOKEN_ENCRYPTION_KEY="generate-unique-64-char-hex-key"
META_CREDENTIALS_ENCRYPTION_KEY="generate-unique-64-char-hex-key"

# Dados do Administrador Master
ADMIN_EMAIL="admin@seudominio.com"

# Credenciais Meta (App ID, App Secret, Verify Token, Config ID) são cadastradas
# por tenant em Configurações > Integrações Meta (tabela meta_app_connections).
# Não armazene segredos Meta globais neste arquivo.

# Atendimento humano estendido do Instagram (tag HUMAN_AGENT). false até a Meta aprovar.
META_HUMAN_AGENT_ENABLED="false"
# Pré-visualização de janela só em development/staging. Não altera o envio real.
META_REVIEW_TEST_MODE="false"
# Monitoramento de hashtags (Instagram Public Content). Módulo não exibido enquanto false.
META_INSTAGRAM_PUBLIC_CONTENT_ENABLED="false"

# TURN (coturn) para WhatsApp Cloud Calling atrás de NAT simétrico / 4G
# Sem estas credenciais o browser usa só STUN e a Meta pode devolver 138021/138023.
TURN_USERNAME="blivturn"
TURN_CREDENTIAL="generate-unique-turn-password"
TURN_REALM="app.seudominio.com"
TURN_EXTERNAL_IP=""
TURN_URLS="turn:app.seudominio.com:3478?transport=udp,turn:app.seudominio.com:3478?transport=tcp"

